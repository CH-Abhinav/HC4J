# =====================================================================
# HC4J — Project Ignore File (.gitignore)
# Covers Rust (Cargo), Java (Maven/Gradle), Python Environments, 
# Secret Configs (.env), IDEs, and Native Binaries
# =====================================================================

# --- Environment & Secret Configuration Files ---
.env
.env.local
.env.*.local

# --- Rust / Cargo ---
target/
/target/
native/target/
/native/target/
**/*.rs.bk

# Cargo.lock is committed on purpose.
!native/Cargo.lock

# --- Java / Build Systems (Maven & Gradle) ---
build/
/build/
**/build/
.gradle/
*.class
*.jar
*.war
*.ear
hs_err_pid*

# The wrapper jar MUST be committed:
!gradle/wrapper/gradle-wrapper.jar

# --- Audit & Local Docs ---
HC4J_AUDIT.md

# --- IDEs & Editors ---
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# --- Native Shared Libraries / Build Outputs ---
*.dll
*.so
*.dylib

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
