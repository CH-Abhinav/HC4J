# =====================================================================
# HC4J — Project Ignore File (.gitignore)
# Covers Rust (Cargo), Java (Maven/Gradle), Python Environments, 
# Secret Configs (.env), IDEs, and Native Binaries
# =====================================================================

# --- Environment & Secret Configuration Files ---
.env
.env.local
.env.*.local

# --- Rust / Cargo ---
/target/
**/*.rs.bk
Cargo.lock


# --- Java / Build Systems (Maven & Gradle) ---
/build/
.gradle/
*.class
*.jar
*.war
*.ear
hs_err_pid*

# --- IDEs & Editors ---
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# --- Native Shared Libraries / Build Outputs ---
*.dll
*.so
*.dylib

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


